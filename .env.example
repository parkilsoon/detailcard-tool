# ── 프로바이더 선택: anthropic | gemini ──
LLM_PROVIDER=anthropic

# 키는 쓰는 쪽만 채우면 된다
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 모델. 비우면 프로바이더별 기본값 (anthropic: claude-opus-5 / gemini: gemini-2.5-pro)
LLM_MODEL=

# 응답 최대 토큰. Gemini 2.5 Pro 는 thinking 토큰도 포함되므로 8000 이면 밀도 높은 카드가 잘린다
LLM_MAX_TOKENS=16000

# ── 이미지 슬라이스 ──
# 슬라이스 높이(px)를 직접 지정. 비우면 프로바이더별 기본 규칙:
#   anthropic: 28px 패치 × 비주얼 토큰 한도(LLM_MAX_VISUAL_TOKENS)로 계산 → 1440px 폭 기준 840px
#   gemini   : 768px 타일 1단 = 768px (1536px 대비 작은 글씨 오류가 줄었음)
SLICE_HEIGHT=
# 검증 방식: lines(기본, 모든 문구 나열 후 대조) | structured(2차 구조화 전사 diff)
VERIFY_MODE=lines
# 검증(2차 전사)용 슬라이스 높이(px). 1차와 다르게 잘라 시야를 바꾼다. 비우면 1차의 2배
VERIFY_SLICE_HEIGHT=
# 모델이 받는 최대 장변(px). 비우면 anthropic 1568 / gemini 3072
LLM_MAX_LONG_EDGE=
# anthropic 전용. 표준 티어 1568. 고해상도 티어 모델이면 높인다
LLM_MAX_VISUAL_TOKENS=

# ── anthropic 전용 옵션 ──
# 추론 강도 (low|medium|high|xhigh|max). 비우면 API 기본값(high)
LLM_EFFORT=
# 안전 분류기 거부 시 서버측 폴백 (default | off)
LLM_FALLBACKS=default

# ── gemini 전용 옵션 ──
# thinking 토큰 예산 (gemini-2.5-pro: 128~32768, 비우면 모델 자동). 2.5-pro 는 thinking 을 끌 수 없다
LLM_THINKING_BUDGET=
# 이미지 해상도 (LOW|MEDIUM|HIGH). Gemini 3 계열에서만 의미 있음. 비우면 기본
LLM_MEDIA_RESOLUTION=

# ── 공통 ──
# temperature. gemini 는 비우면 0. anthropic 현행 모델(Opus 5 등)은 이 파라미터를 거부하므로 비워둔다
LLM_TEMPERATURE=

# ── 다중 등록 ──
# 동시에 처리할 카드 수. API 속도 제한에 걸리면 낮춘다
PIPELINE_WORKERS=3
# 한 번에 올릴 수 있는 최대 장수
BATCH_MAX_FILES=50
